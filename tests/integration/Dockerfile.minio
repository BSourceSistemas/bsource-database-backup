# Test-only fixture: upstream Docker Hub/Quay images are no longer public.
# Checksums are from the matching official GitHub release assets.
ARG BACKUP_IMAGE=bsource-database-backup:test
FROM ${BACKUP_IMAGE}
USER root
RUN curl --retry 3 --retry-all-errors --connect-timeout 15 --max-time 300 -fsSL \
      https://github.com/minio/minio/releases/download/RELEASE.2025-04-22T22-12-26Z/minio.linux-amd64.RELEASE.2025-04-22T22-12-26Z \
      -o /usr/local/bin/minio && \
    echo '53e2a2cb16c5366ea6fbbc479c19ddb4c6a0948273e752f740fb1fbf27bb817c  /usr/local/bin/minio' | sha256sum -c - && \
    curl --retry 3 --retry-all-errors --connect-timeout 15 --max-time 300 -fsSL \
      https://github.com/minio/mc/releases/download/RELEASE.2025-04-16T18-13-26Z/mc.linux-amd64.RELEASE.2025-04-16T18-13-26Z \
      -o /usr/local/bin/mc && \
    echo 'ac90da87a35641be5a0ac75d49de5161ddb47d629b5ba01261b0ae9e00aea15f  /usr/local/bin/mc' | sha256sum -c - && \
    chmod 0755 /usr/local/bin/minio /usr/local/bin/mc
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
HEALTHCHECK NONE
