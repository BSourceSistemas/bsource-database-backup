# One container protects exactly one database.
APP_ENV=production
RUN_MODE=scheduler
RUN_ON_START=true
BACKUP_CRON=0 2 * * *
BACKUP_TIMEZONE=America/Sao_Paulo
BACKUP_TIMEOUT_SECONDS=3600
BACKUP_MISFIRE_GRACE_TIME_SECONDS=300
BACKUP_JITTER_SECONDS=0
SHUTDOWN_GRACE_SECONDS=30
MAX_BACKUP_AGE_SECONDS=129600
MAX_CONSECUTIVE_FAILURES=3
STATE_FILE=/var/lib/bsource-backup/state.json
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# postgres | mysql | mariadb | mongodb | mssql
DB_TYPE=postgres
DB_HOST=database
DB_PORT=5432
DB_USER=backup
DB_DATABASE=AppTreino
# Configure exactly one password source.
DB_PASSWORD=
# DB_PASSWORD_FILE=/run/secrets/db_password
DB_AUTH_SOURCE=admin

# Required only for DB_TYPE=mssql. Both paths must refer to the same volume.
# MSSQL_BACKUP_MODE=shared-volume
# MSSQL_SERVER_BACKUP_DIR=/var/opt/mssql/backup
# MSSQL_LOCAL_BACKUP_DIR=/shared/mssql

# s3 | r2 | local
STORAGE_TYPE=s3
STORAGE_REGION=sa-east-1
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# AWS_ACCESS_KEY_ID_FILE=/run/secrets/storage_access_key
# AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/storage_secret_key
STORAGE_BUCKET_NAME=
STORAGE_DESTINATION_FOLDER=backups/
# STORAGE_LOCAL_PATH=/app/backups

# noop | email | webhook. If omitted, complete legacy EMAIL_* values infer email.
NOTIFICATION_PROVIDER=noop
NOTIFY_ON_SUCCESS=false
NOTIFY_ON_FAILURE=true
NOTIFY_ON_RECOVERY=true
NOTIFY_AFTER_FAILURES=1
NOTIFICATION_COOLDOWN_SECONDS=3600
EMAIL_FROM=
EMAIL_TO=
EMAIL_SMTP=
EMAIL_PORT=587
# credentials | none. Credentials are required only in credentials mode.
EMAIL_AUTH_MODE=credentials
EMAIL_USER=
EMAIL_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
EMAIL_STARTTLS=true
# WEBHOOK_URL=https://example.invalid/backup-events

# Optional Seq integration configuration.
# SEQ_URL=
# SEQ_API_KEY=
# SEQ_API_KEY_FILE=/run/secrets/seq_api_key

# Deprecated aliases, accepted during the migration period:
# CRON_SCHEDULE=0 2 * * *
# TIMEZONE=America/Sao_Paulo
